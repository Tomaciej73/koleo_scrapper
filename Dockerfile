# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE
ARG APP_HOME
ARG APP_PORT
ARG APP_DATA_DIR
ARG NATIVE_BUILD_PACKAGES

FROM ${NODE_IMAGE} AS build

ARG APP_HOME
ARG APP_DATA_DIR
ARG NATIVE_BUILD_PACKAGES
ARG BUILD_DB_CONNECTION
ARG BUILD_SQLITE_BUSY_TIMEOUT_MS
ARG BUILD_DB_BACKUP_DIR
ARG BUILD_DB_BACKUP_RETENTION_COUNT
ARG BUILD_LIMITER_STORE
ARG BUILD_RATE_LIMIT_AUTH_REQUESTS
ARG BUILD_RATE_LIMIT_LOGIN_FAILURES
ARG BUILD_RATE_LIMIT_OTP_REQUESTS
ARG BUILD_RATE_LIMIT_SEARCH_REQUESTS
ARG BUILD_RATE_LIMIT_CHECK_NOW_REQUESTS
ARG BUILD_RATE_LIMIT_PASSWORD_RESET_REQUESTS
ARG BUILD_RATE_LIMIT_CSP_REPORT_REQUESTS
ARG BUILD_RATE_LIMIT_AUTH_WINDOW_SECONDS
ARG BUILD_RATE_LIMIT_SEARCH_WINDOW_SECONDS
ARG BUILD_RATE_LIMIT_CHECK_NOW_WINDOW_SECONDS
ARG BUILD_RATE_LIMIT_BLOCK_SECONDS
ARG BUILD_TRUSTED_PROXIES
ARG BUILD_CSP_ENABLED
ARG BUILD_CSP_REPORT_ONLY
ARG BUILD_CSP_DEFAULT_SRC
ARG BUILD_CSP_SCRIPT_SRC
ARG BUILD_CSP_STYLE_SRC
ARG BUILD_CSP_IMG_SRC
ARG BUILD_CSP_FONT_SRC
ARG BUILD_CSP_CONNECT_SRC
ARG BUILD_CSP_OBJECT_SRC
ARG BUILD_CSP_BASE_URI
ARG BUILD_CSP_FORM_ACTION
ARG BUILD_CSP_FRAME_ANCESTORS
ARG BUILD_CSP_REPORT_URI
ARG BUILD_CSP_UPGRADE_INSECURE_REQUESTS
ARG BUILD_PASSWORD_MIN_LENGTH
ARG BUILD_PASSWORD_MAX_LENGTH
ARG BUILD_PASSWORD_RESET_TOKEN_TTL_MINUTES
ARG BUILD_PASSWORD_RESET_MIN_RESPONSE_MS
ARG BUILD_PRICE_WATCH_MAX_PER_USER
ARG BUILD_ALERT_DAILY_MAX_MESSAGES_PER_USER
ARG BUILD_ALERT_WATCH_LOCK_TIMEOUT_SECONDS
ARG BUILD_ALERT_OUTBOX_BATCH_SIZE
ARG BUILD_ALERT_OUTBOX_MAX_ATTEMPTS
ARG BUILD_ALERT_OUTBOX_RETRY_BASE_SECONDS
ARG BUILD_ALERT_OUTBOX_RETRY_MAX_SECONDS
ARG BUILD_ALERT_OUTBOX_LOCK_TIMEOUT_SECONDS
ARG BUILD_TICKET_SALES_MAX_ADVANCE_DAYS
ARG BUILD_BODY_PARSER_FORM_LIMIT
ARG BUILD_BODY_PARSER_JSON_LIMIT
ARG BUILD_BODY_PARSER_MULTIPART_LIMIT
ARG BUILD_HEALTH_WORKER_STALE_SECONDS
ENV CI=true

WORKDIR ${APP_HOME}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ${NATIVE_BUILD_PACKAGES} \
    && rm -rf /var/lib/apt/lists/*

# The web application depends on the local open-koleo package from the
# repository root, so both package manifests and the wrapper sources are
# part of the dependency layer.
COPY package.json index.js ./
COPY src ./src
COPY web/package.json web/package-lock.json ./web/

WORKDIR ${APP_HOME}/web
RUN npm ci

COPY web ./

# Adonis validates configuration during the build. BuildKit exposes secrets
# from web/.env only for this command. Non-secret operational settings come
# from .env_conf through build args, so they do not have to be duplicated in
# web/.env and are not persisted as ENV entries in the runtime image.
RUN --mount=type=secret,id=app_env,target=${APP_HOME}/web/.env,required=true \
    export DB_CONNECTION="${BUILD_DB_CONNECTION}" \
    SQLITE_BUSY_TIMEOUT_MS="${BUILD_SQLITE_BUSY_TIMEOUT_MS}" \
    DB_BACKUP_DIR="${BUILD_DB_BACKUP_DIR}" \
    DB_BACKUP_RETENTION_COUNT="${BUILD_DB_BACKUP_RETENTION_COUNT}" \
    LIMITER_STORE="${BUILD_LIMITER_STORE}" \
    RATE_LIMIT_AUTH_REQUESTS="${BUILD_RATE_LIMIT_AUTH_REQUESTS}" \
    RATE_LIMIT_LOGIN_FAILURES="${BUILD_RATE_LIMIT_LOGIN_FAILURES}" \
    RATE_LIMIT_OTP_REQUESTS="${BUILD_RATE_LIMIT_OTP_REQUESTS}" \
    RATE_LIMIT_SEARCH_REQUESTS="${BUILD_RATE_LIMIT_SEARCH_REQUESTS}" \
    RATE_LIMIT_CHECK_NOW_REQUESTS="${BUILD_RATE_LIMIT_CHECK_NOW_REQUESTS}" \
    RATE_LIMIT_PASSWORD_RESET_REQUESTS="${BUILD_RATE_LIMIT_PASSWORD_RESET_REQUESTS}" \
    RATE_LIMIT_CSP_REPORT_REQUESTS="${BUILD_RATE_LIMIT_CSP_REPORT_REQUESTS}" \
    RATE_LIMIT_AUTH_WINDOW_SECONDS="${BUILD_RATE_LIMIT_AUTH_WINDOW_SECONDS}" \
    RATE_LIMIT_SEARCH_WINDOW_SECONDS="${BUILD_RATE_LIMIT_SEARCH_WINDOW_SECONDS}" \
    RATE_LIMIT_CHECK_NOW_WINDOW_SECONDS="${BUILD_RATE_LIMIT_CHECK_NOW_WINDOW_SECONDS}" \
    RATE_LIMIT_BLOCK_SECONDS="${BUILD_RATE_LIMIT_BLOCK_SECONDS}" \
    TRUSTED_PROXIES="${BUILD_TRUSTED_PROXIES}" \
    CSP_ENABLED="${BUILD_CSP_ENABLED}" \
    CSP_REPORT_ONLY="${BUILD_CSP_REPORT_ONLY}" \
    CSP_DEFAULT_SRC="${BUILD_CSP_DEFAULT_SRC}" \
    CSP_SCRIPT_SRC="${BUILD_CSP_SCRIPT_SRC}" \
    CSP_STYLE_SRC="${BUILD_CSP_STYLE_SRC}" \
    CSP_IMG_SRC="${BUILD_CSP_IMG_SRC}" \
    CSP_FONT_SRC="${BUILD_CSP_FONT_SRC}" \
    CSP_CONNECT_SRC="${BUILD_CSP_CONNECT_SRC}" \
    CSP_OBJECT_SRC="${BUILD_CSP_OBJECT_SRC}" \
    CSP_BASE_URI="${BUILD_CSP_BASE_URI}" \
    CSP_FORM_ACTION="${BUILD_CSP_FORM_ACTION}" \
    CSP_FRAME_ANCESTORS="${BUILD_CSP_FRAME_ANCESTORS}" \
    CSP_REPORT_URI="${BUILD_CSP_REPORT_URI}" \
    CSP_UPGRADE_INSECURE_REQUESTS="${BUILD_CSP_UPGRADE_INSECURE_REQUESTS}" \
    PASSWORD_MIN_LENGTH="${BUILD_PASSWORD_MIN_LENGTH}" \
    PASSWORD_MAX_LENGTH="${BUILD_PASSWORD_MAX_LENGTH}" \
    PASSWORD_RESET_TOKEN_TTL_MINUTES="${BUILD_PASSWORD_RESET_TOKEN_TTL_MINUTES}" \
    PASSWORD_RESET_MIN_RESPONSE_MS="${BUILD_PASSWORD_RESET_MIN_RESPONSE_MS}" \
    PRICE_WATCH_MAX_PER_USER="${BUILD_PRICE_WATCH_MAX_PER_USER}" \
    ALERT_DAILY_MAX_MESSAGES_PER_USER="${BUILD_ALERT_DAILY_MAX_MESSAGES_PER_USER}" \
    ALERT_WATCH_LOCK_TIMEOUT_SECONDS="${BUILD_ALERT_WATCH_LOCK_TIMEOUT_SECONDS}" \
    ALERT_OUTBOX_BATCH_SIZE="${BUILD_ALERT_OUTBOX_BATCH_SIZE}" \
    ALERT_OUTBOX_MAX_ATTEMPTS="${BUILD_ALERT_OUTBOX_MAX_ATTEMPTS}" \
    ALERT_OUTBOX_RETRY_BASE_SECONDS="${BUILD_ALERT_OUTBOX_RETRY_BASE_SECONDS}" \
    ALERT_OUTBOX_RETRY_MAX_SECONDS="${BUILD_ALERT_OUTBOX_RETRY_MAX_SECONDS}" \
    ALERT_OUTBOX_LOCK_TIMEOUT_SECONDS="${BUILD_ALERT_OUTBOX_LOCK_TIMEOUT_SECONDS}" \
    TICKET_SALES_MAX_ADVANCE_DAYS="${BUILD_TICKET_SALES_MAX_ADVANCE_DAYS}" \
    BODY_PARSER_FORM_LIMIT="${BUILD_BODY_PARSER_FORM_LIMIT}" \
    BODY_PARSER_JSON_LIMIT="${BUILD_BODY_PARSER_JSON_LIMIT}" \
    BODY_PARSER_MULTIPART_LIMIT="${BUILD_BODY_PARSER_MULTIPART_LIMIT}" \
    HEALTH_WORKER_STALE_SECONDS="${BUILD_HEALTH_WORKER_STALE_SECONDS}" \
    && node ace codegen \
    && npm run build

RUN npm prune --omit=dev && npm cache clean --force

FROM ${NODE_IMAGE} AS runtime

ARG APP_HOME
ARG APP_PORT
ARG APP_DATA_DIR

ENV NODE_ENV=production \
    APP_HOME=${APP_HOME}

WORKDIR ${APP_HOME}

COPY --from=build --chown=node:node ${APP_HOME}/package.json ${APP_HOME}/index.js ./
COPY --from=build --chown=node:node ${APP_HOME}/src ./src

WORKDIR ${APP_HOME}/web
COPY --from=build --chown=node:node ${APP_HOME}/web/build ./
COPY --from=build --chown=node:node ${APP_HOME}/web/node_modules ./node_modules

RUN mkdir -p "${APP_DATA_DIR}" && chown -R node:node "${APP_DATA_DIR}"

USER node

EXPOSE ${APP_PORT}
STOPSIGNAL SIGTERM

CMD ["node", "bin/server.js"]

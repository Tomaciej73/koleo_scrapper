KOLEO_EOL_RESPONSE_VERSION=1
KOLEO_REQUEST_TIMEOUT_MS=1000
KOLEO_REQUEST_MAX_RETRIES=1
KOLEO_REQUEST_RETRY_BASE_DELAY_MS=1
KOLEO_REQUEST_RETRY_MAX_DELAY_MS=2
KOLEO_REQUEST_MAX_CONCURRENCY=2
STATION_SEARCH_MIN_LENGTH=2
STATION_SEARCH_RESULT_LIMIT=8
STATION_SEARCH_CACHE_SECONDS=300
ALERTS_ENABLED=false
ALERT_CHECK_INTERVAL_MINUTES=15
ALERT_MIN_CHECK_INTERVAL_MINUTES=5
ALERT_MAX_CHECK_INTERVAL_MINUTES=1440
ALERT_WORKER_TICK_SECONDS=60
MAIL_ENABLED=true
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
TICKET_SALES_MAX_ADVANCE_DAYS=90
BODY_PARSER_FORM_LIMIT=128kb
BODY_PARSER_JSON_LIMIT=128kb
BODY_PARSER_MULTIPART_LIMIT=256kb
HEALTH_WORKER_STALE_SECONDS=180
METRICS_TOKEN=test-metrics-token
MAIL_MAILER=smtp
MAIL_FROM_NAME=Koleo Watch Test
MAIL_FROM_ADDRESS=test@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USERNAME=

SESSION_DRIVER=memory
DB_DATABASE=tmp/test.sqlite3
DB_CONNECTION=sqlite
DB_DEBUG=false
SQLITE_BUSY_TIMEOUT_MS=5000
DB_BACKUP_DIR=tmp/test-backups
DB_BACKUP_RETENTION_COUNT=3
PRICE_PROVIDER=demo
KOLEO_API_BASE_URL=https://example.test/v2

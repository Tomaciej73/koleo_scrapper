@layouts.email({ title: 'Potwierdź adres e-mail', preheader: 'Kod aktywacyjny konta Koleo Watch' })
  <p style="margin: 0 0 18px;">Dokończ zakładanie konta. Wpisz poniższy kod na stronie potwierdzenia adresu e-mail:</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; margin: 0 0 18px;">
    <tr>
      <td align="center" style="padding: 18px; background-color: #e9f8f5; border: 1px solid #b8e7de; border-radius: 10px; color: #0c625b; font-size: 30px; font-weight: 700; letter-spacing: 0.18em;">
        {{ code }}
      </td>
    </tr>
  </table>
  <p style="margin: 0 0 20px;">Kod jest ważny przez <strong>{{ validForMinutes }} min</strong>.</p>
  <p style="margin: 0; color: #5a6e6b; font-size: 13px;">Jeśli to nie Ty zakładasz konto, zignoruj tę wiadomość.</p>
@end

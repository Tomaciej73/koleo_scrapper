@layouts.email({ title: 'Ustaw nowe hasło', preheader: 'Jednorazowy link do zmiany hasła' })
  <p style="margin: 0 0 22px;">Otrzymaliśmy prośbę o zmianę hasła do Twojego konta. Aby kontynuować, użyj poniższego przycisku:</p>
  <p style="margin: 0 0 22px;">
    <a href="{{ resetUrl }}" style="display: inline-block; padding: 13px 22px; background-color: #0f766e; border-radius: 8px; color: #ffffff; font-size: 15px; font-weight: 700; text-decoration: none;">Ustaw nowe hasło</a>
  </p>
  <p style="margin: 0 0 12px;">Link jest jednorazowy i ważny przez <strong>{{ validForMinutes }} min</strong>.</p>
  <p style="margin: 0 0 8px; color: #5a6e6b; font-size: 13px;">Jeżeli przycisk nie działa, skopiuj adres do przeglądarki:</p>
  <p style="margin: 0 0 22px; font-size: 13px; overflow-wrap: anywhere; word-break: break-all;"><a href="{{ resetUrl }}" style="color: #0f766e;">{{ resetUrl }}</a></p>
  <p style="margin: 0; color: #5a6e6b; font-size: 13px;">Jeśli to nie Ty wysłałeś prośbę, zignoruj tę wiadomość. Twoje hasło nie zostało zmienione.</p>
@end

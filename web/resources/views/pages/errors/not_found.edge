@layouts.marketing()
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status pc-status--muted mono tag"><span class="dot"></span> 404</span>
      </div>
      <div class="pc-lead"><span>Nie znaleziono.</span> <em>Taka strona nie istnieje.</em></div>
      <p class="pc-para">
        The page you tried to reach doesn't exist. Check the URL or head back home.
      </p>
    </article>
  </div>
@end

@layouts.marketing({ title: 'Błąd serwera' })
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status pc-status--error mono tag">
          <span class="dot"></span>
          {{ error.code || 500 }}
        </span>
      </div>
      <div class="pc-lead">
        <span>Coś poszło nie tak.</span>
        <em>Serwer napotkał nieoczekiwany błąd.</em>
      </div>
      <p class="pc-para">
        Try again in a moment. If the problem persists, check the server logs for the underlying exception.
      </p>
    </article>
  </div>
@end

@layouts.app({ title: 'Wyszukiwarka' })
  @page()
    <section class="dashboard-hero">
      <div>
        <span class="eyebrow">Znajdź połączenie</span>
        <h1>Dokąd jedziesz?</h1>
        <p>Wybierz trasę i termin, a potem dodaj konkretny kurs do obserwowanych.</p>
      </div>
      <div class="mode-badges">
        <span
          class="status-pill {{ providerMode === 'demo' ? 'status-pill--demo' : 'status-pill--ok' }}"
        >
          {{ providerMode === 'demo' ? 'Tryb demo' : 'Dane na żywo' }}
        </span>
        <span class="status-pill {{ alertsEnabled ? 'status-pill--ok' : 'status-pill--muted' }}">
          {{ alertsEnabled ? 'Alerty aktywne' : 'Alerty wyłączone' }}
        </span>
      </div>
    </section>
    @if(providerMode === 'demo')
      <div class="notice notice--info">
        @svg('lucide:flask-conical', { width: 18, height: 18 })
        <div>
          <strong>Bezpieczny tryb demonstracyjny</strong>
          <span>
            Wyniki są generowane lokalnie. Cały interfejs można przetestować bez zapytań do KOLEO.
          </span>
        </div>
      </div>
    @end

    <section class="search-card">
      @form({
        route: 'connections.search',
        method: 'POST',
        class: 'search-form',
        'x-data': 'journeySearch',
        'x-on:submit': 'handleSubmit($event)',
      })
        <div
          class="search-field search-field--station station-autocomplete"
          x-data="stationAutocomplete"
          data-endpoint="{{ urlFor('stations.search') }}"
          data-field="origin"
          data-min-length="{{ stationSearchMinLength }}"
          data-selected-id="{{ search && search.originStationId ? search.originStationId : '' }}"
          x-on:click.outside="close()"
          x-on:journey-stations-swapped.window="applyExternalValue($event.detail)"
        >
          <label for="origin-station">Skąd</label>
          <div class="search-field__control">
            @svg('lucide:map-pin', { width: 18, height: 18 })
            <input
              id="origin-station"
              x-ref="input"
              x-model="query"
              type="text"
              name="origin"
              value="{{ search ? search.origin : '' }}"
              placeholder="np. Wrocław Główny"
              autocomplete="off"
              role="combobox"
              aria-autocomplete="list"
              aria-controls="origin-stations-list"
              x-bind:aria-expanded="open"
              x-bind:aria-activedescendant="activeOptionId"
              x-on:input="onInput()"
              x-on:focus="openResults()"
              x-on:keydown.arrow-down.prevent="move(1)"
              x-on:keydown.arrow-up.prevent="move(-1)"
              x-on:keydown.enter="chooseActive($event)"
              x-on:keydown.escape.prevent="close()"
              required
            />
            <input
              x-ref="stationId"
              x-model="stationId"
              type="hidden"
              name="originStationId"
              value="{{ search && search.originStationId ? search.originStationId : '' }}"
              data-station-id
            />
            <span class="station-autocomplete__spinner" x-bind:hidden="!loading" hidden x-cloak>
              @svg('lucide:loader-circle', { width: 16, height: 16 })
            </span>
          </div>
          <div
            id="origin-stations-list"
            class="station-suggestions"
            role="listbox"
            x-bind:hidden="!open"
            hidden
            x-transition.opacity.duration.120ms
            x-cloak
          >
            <template x-for="(station, index) in stations" x-bind:key="station.id">
              <button
                type="button"
                role="option"
                class="station-suggestion"
                x-bind:id="optionId(index)"
                x-bind:class="{ 'station-suggestion--active': index === activeIndex }"
                x-bind:aria-selected="index === activeIndex"
                x-on:mouseenter="activeIndex = index"
                x-on:click="select(station)"
              >
                @svg('lucide:train-front', { width: 17, height: 17 })
                <span><strong x-text="station.name"></strong><small>Stacja kolejowa</small></span>
              </button>
            </template>
            <div
              class="station-suggestions__empty"
              x-bind:hidden="!(searched && !loading && !stations.length)"
              hidden
              aria-live="polite"
            >
              <span x-text="errorMessage || 'Nie znaleziono pasującej stacji'"></span>
            </div>
          </div>
        </div>

        <button
          type="button"
          class="search-swap"
          x-on:click="swapStations()"
          aria-label="Zamień stację początkową z docelową"
          title="Zamień stacje"
        >
          @svg('lucide:arrow-right-left', { width: 17, height: 17 })
        </button>

        <div
          class="search-field search-field--station station-autocomplete"
          x-data="stationAutocomplete"
          data-endpoint="{{ urlFor('stations.search') }}"
          data-field="destination"
          data-min-length="{{ stationSearchMinLength }}"
          data-selected-id="{{ search && search.destinationStationId ? search.destinationStationId : '' }}"
          x-on:click.outside="close()"
          x-on:journey-stations-swapped.window="applyExternalValue($event.detail)"
        >
          <label for="destination-station">Dokąd</label>
          <div class="search-field__control">
            @svg('lucide:map-pin-check', { width: 18, height: 18 })
            <input
              id="destination-station"
              x-ref="input"
              x-model="query"
              type="text"
              name="destination"
              value="{{ search ? search.destination : '' }}"
              placeholder="np. Olsztyn Główny"
              autocomplete="off"
              role="combobox"
              aria-autocomplete="list"
              aria-controls="destination-stations-list"
              x-bind:aria-expanded="open"
              x-bind:aria-activedescendant="activeOptionId"
              x-on:input="onInput()"
              x-on:focus="openResults()"
              x-on:keydown.arrow-down.prevent="move(1)"
              x-on:keydown.arrow-up.prevent="move(-1)"
              x-on:keydown.enter="chooseActive($event)"
              x-on:keydown.escape.prevent="close()"
              required
            />
            <input
              x-ref="stationId"
              x-model="stationId"
              type="hidden"
              name="destinationStationId"
              value="{{ search && search.destinationStationId ? search.destinationStationId : '' }}"
              data-station-id
            />
            <span class="station-autocomplete__spinner" x-bind:hidden="!loading" hidden x-cloak>
              @svg('lucide:loader-circle', { width: 16, height: 16 })
            </span>
          </div>
          <div
            id="destination-stations-list"
            class="station-suggestions"
            role="listbox"
            x-bind:hidden="!open"
            hidden
            x-transition.opacity.duration.120ms
            x-cloak
          >
            <template x-for="(station, index) in stations" x-bind:key="station.id">
              <button
                type="button"
                role="option"
                class="station-suggestion"
                x-bind:id="optionId(index)"
                x-bind:class="{ 'station-suggestion--active': index === activeIndex }"
                x-bind:aria-selected="index === activeIndex"
                x-on:mouseenter="activeIndex = index"
                x-on:click="select(station)"
              >
                @svg('lucide:train-front', { width: 17, height: 17 })
                <span><strong x-text="station.name"></strong><small>Stacja kolejowa</small></span>
              </button>
            </template>
            <div
              class="station-suggestions__empty"
              x-bind:hidden="!(searched && !loading && !stations.length)"
              hidden
              aria-live="polite"
            >
              <span x-text="errorMessage || 'Nie znaleziono pasującej stacji'"></span>
            </div>
          </div>
        </div>

        <label class="search-field search-field--date">
          <span>Data</span>
          <div class="search-field__control">
            @svg('lucide:calendar-days', { width: 18, height: 18 })
            <input
              type="date"
              name="travelDate"
              value="{{ search ? search.travelDate : defaultDate }}"
              required
            />
          </div>
        </label>

        <label class="search-field search-field--time">
          <span>Godzina</span>
          <div class="search-field__control">
            @svg('lucide:clock-3', { width: 18, height: 18 })
            <input
              type="time"
              name="departureTime"
              value="{{ search && search.departureTime ? search.departureTime : '' }}"
            />
          </div>
        </label>

        <label class="direct-check">
          <input
            type="checkbox"
            name="onlyDirect"
            value="true"
            {{ search && search.onlyDirect ? 'checked' : '' }}
          />
          <span>Bez przesiadek</span>
        </label>

        <button type="submit" class="btn btn--primary search-submit" x-bind:disabled="submitting">
          @svg('lucide:search', { width: 17, height: 17 })
          <span x-text="submitting ? 'Szukam…' : 'Szukaj połączeń'">Szukaj połączeń</span>
        </button>
      @end
    </section>
    @if(searchError)
      <div class="notice notice--error">
        @svg('lucide:circle-alert', { width: 18, height: 18 })
        <div><strong>Nie udało się wyszukać</strong><span>{{ searchError }}</span></div>
      </div>
    @end
    @if(results)
      <section class="results-section" x-data="connectionResults">
        <div class="results-heading">
          <div>
            <span class="eyebrow">Wyniki</span>
            <h2>{{ search.origin }} → {{ search.destination }}</h2>
          </div>
          <div class="results-heading__tools">
            <span>{{ results.length }} {{ results.length === 1 ? 'połączenie' : 'połączeń' }}</span>
            @if(results.length > 1)
              <label class="results-sort">
                <span>Sortuj</span>
                <select x-model="sortKey" x-on:change="sortResults()">
                  <option value="departure">godzina odjazdu</option>
                  <option value="price">najniższa cena</option>
                  <option value="duration">najkrótszy czas</option>
                  <option value="changes">najmniej przesiadek</option>
                </select>
              </label>
            @end
          </div>
        </div>
        <p class="availability-disclaimer">
          @svg('lucide:info', { width: 14, height: 14 })
          Status zakupu i cena pochodzą z technicznego źródła KOLEO bez prywatnego
          koszyka użytkownika. Suma na koleo.pl może być inna po dodaniu pasażerów
          lub ulg. Status zakupu nie gwarantuje konkretnego miejsca siedzącego.
        </p>
        @if(results.length === 0)
          <div class="empty-state">
            @svg('lucide:train-front-tunnel', { width: 28, height: 28 })
            <h3>Brak połączeń dla wybranych parametrów</h3>
            <p>Zmień godzinę albo wyłącz filtr połączeń bezpośrednich.</p>
          </div>
        @else
          <div class="connection-list" x-ref="list">
            @each(connection in results)
              <article
                class="connection-card"
                data-departure-sort="{{ connection.departureMinutes }}"
                data-price-sort="{{ connection.priceCents === null ? 9007199254740991 : connection.priceCents }}"
                data-duration-sort="{{ connection.durationMinutes }}"
                data-changes-sort="{{ connection.changes }}"
              >
                <div class="connection-card__main">
                  <div class="connection-time">
                    <strong>{{ connection.departure }}</strong>
                    <span>{{ search.origin }}</span>
                  </div>
                  <div class="connection-track">
                    <div class="connection-track__line"><span></span></div>
                    <span>{{ formatDuration(connection.durationMinutes) }}</span>
                  </div>
                  <div class="connection-time connection-time--right">
                    <strong>{{ connection.arrival }}</strong>
                    @if(connection.arrivalDayOffset > 0)
                      <small class="arrival-next-day">
                        +{{ connection.arrivalDayOffset }}
                        {{ connection.arrivalDayOffset === 1 ? 'dzień' : 'dni' }}
                        ·
                        {{ connection.arrivalDateLabel }}
                      </small>
                    @end

                    <span>{{ search.destination }}</span>
                  </div>
                </div>

                <div class="connection-card__meta">
                  <span>
                    @svg('lucide:train', { width: 15, height: 15 })
                    {{ connection.trains }}
                  </span>
                  <span>
                    @svg('lucide:shuffle', { width: 15, height: 15 })
                    {{
                      connection.changes === 0
                        ? 'bez przesiadek'
                        : `${connection.changes} przesiadki`
                    }}
                  </span>
                  <span
                    class="status-pill {{ connection.ticketAvailability === 'available' ? 'status-pill--ok' : 'status-pill--muted' }}"
                    title="{{ connection.availabilityMessage || 'Informacja dotyczy możliwości zakupu biletu, a nie konkretnego miejsca siedzącego.' }}"
                  >
                    @svg(
                      connection.ticketAvailability === 'available'
                        ? 'lucide:ticket-check'
                        : connection.ticketAvailability === 'unavailable'
                          ? 'lucide:ticket-x'
                          : 'lucide:circle-help',
                      { width: 14, height: 14 }
                    )
                    {{
                      connection.ticketAvailability === 'available'
                        ? 'Zakup dostępny'
                        : connection.ticketAvailability === 'unavailable'
                          ? 'Zakup niedostępny'
                          : 'Dostępność nieznana'
                    }}
                  </span>
                </div>

                <div class="connection-card__action">
                  <div class="connection-price">
                    <span>od</span>
                    <strong>{{ formatPrice(connection.priceCents) }}</strong>
                    @if(connection.availabilityMessage)
                      <small>
                        {{ connection.availabilityMessage }}
                      </small>
                    @end
                  </div>

                  <details class="watch-details">
                    <summary class="btn btn--secondary">
                      @svg('lucide:bell-plus', { width: 16, height: 16 })
                      Obserwuj cenę
                    </summary>
                    <div class="watch-popover">
                      @form({
                        route: 'price_watches.store',
                        method: 'POST',
                        class: 'watch-form',
                        'x-data': 'submittingForm',
                        'x-on:submit': 'handleSubmit($event)',
                      })
                        <input type="hidden" name="origin" value="{{ search.origin }}" />
                        @if(search.originStationId)
                          <input
                            type="hidden"
                            name="originStationId"
                            value="{{ search.originStationId }}"
                          />
                        @end

                        <input type="hidden" name="destination" value="{{ search.destination }}" />
                        @if(search.destinationStationId)
                          <input
                            type="hidden"
                            name="destinationStationId"
                            value="{{ search.destinationStationId }}"
                          />
                        @end

                        <input type="hidden" name="travelDate" value="{{ search.travelDate }}" />
                        <input
                          type="hidden"
                          name="departureTime"
                          value="{{ connection.departure }}"
                        />
                        <input type="hidden" name="arrivalTime" value="{{ connection.arrival }}" />
                        <input
                          type="hidden"
                          name="arrivalDate"
                          value="{{ connection.arrivalDate }}"
                        />
                        <input type="hidden" name="connectionUuid" value="{{ connection.uuid }}" />
                        <input type="hidden" name="trainName" value="{{ connection.trains }}" />
                        <input
                          type="hidden"
                          name="ticketAvailability"
                          value="{{ connection.ticketAvailability }}"
                        />
                        @if(connection.availabilityMessage)
                          <input
                            type="hidden"
                            name="availabilityMessage"
                            value="{{ connection.availabilityMessage }}"
                          />
                        @end
                        @if(connection.priceCents !== null)
                          <input
                            type="hidden"
                            name="priceCents"
                            value="{{ connection.priceCents }}"
                          />
                        @end

                        <label>
                          <span>Maksymalna cena do alertu (opcjonalnie)</span>
                          <input
                            type="number"
                            name="targetPrice"
                            min="0.01"
                            step="0.01"
                            placeholder="np. 65.00"
                          />
                          <small>
                            Alert przyjdzie przy każdej zmianie ceny. Próg 65 zł dodatkowo
                            powiadomi przy pierwszym potwierdzeniu ceny 65,00 zł lub niższej.
                          </small>
                        </label>
                        <label>
                          <span>Sprawdzaj co ile minut</span>
                          <input
                            type="number"
                            name="checkIntervalMinutes"
                            min="{{ minimumCheckInterval }}"
                            max="{{ maximumCheckInterval }}"
                            step="1"
                            value="{{ defaultCheckInterval }}"
                            required
                          />
                        </label>
                        <p class="field__hint">
                          Alert zostanie wysłany na potwierdzony adres e-mail przypisany do Twojego konta.
                        </p>
                        <button
                          type="submit"
                          class="btn btn--primary btn--block"
                          x-bind:disabled="submitting"
                        >
                          <span x-text="submitting ? 'Zapisuję…' : 'Zapisz obserwację'">
                            Zapisz obserwację
                          </span>
                        </button>
                      @end
                    </div>
                  </details>
                </div>
              </article>
            @end
          </div>
        @end
      </section>
    @end
  @end
@end

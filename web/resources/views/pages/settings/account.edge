@layouts.settings({ title: 'Konto i bezpieczeństwo' })
  <div class="account-settings">
    <section class="account-section">
      <div>
        <span class="eyebrow">Profil</span>
        <h2>Adres e-mail</h2>
        <p>Zmiana adresu wymaga aktualnego hasła i ponownego potwierdzenia kodem.</p>
        <p>
          Do potwierdzenia nowego adresu logowanie, reset hasła i alerty używają dotychczasowego adresu.
        </p>
      </div>
      @if(user.pendingEmail)
        <div class="notice notice--info">
          @svg('lucide:mail-check', { width: 18, height: 18 })
          <div>
            <strong>Zmiana adresu oczekuje na potwierdzenie</strong>
            <span>
              Kod wysłano na
              {{ user.pendingEmail }}. Dotychczasowy adres
              {{ user.email }}
              nadal działa.
            </span>
            @link({ route: 'email_verification.create', class: 'il' })
              Wpisz kod lub wyślij go ponownie
            @end
          </div>
        </div>
      @end
      <details
        class="account-action"
        id="change-email"
        {{
          html.attrs({
            open:
              old('accountAction') === 'email' ||
              flashMessages.get('accountAction') === 'email',
          })
        }}
      >
        <summary class="btn btn--secondary">
          @svg('lucide:mail', { width: 16, height: 16 })
          Zmień adres e-mail
        </summary>
        @form({
          route: 'account.email',
          method: 'POST',
          class: 'account-form',
          'x-data': 'submittingForm',
          'x-on:submit': 'handleSubmit($event)',
        })
          <input type="hidden" name="accountAction" value="email" />
          @field.root({ name: 'email' })
            @!field.label({ text: 'Nowy adres e-mail' })
            @!input.control({
              type: 'email',
              value: user.email,
              autocomplete: 'email',
              maxlength: emailMaxLength,
            })
            @!field.error()
          @end
          @field.root({ name: 'currentPassword' })
            @!field.label({ text: 'Aktualne hasło' })
            @!input.control({
              type: 'password',
              autocomplete: 'current-password',
              maxlength: passwordMaxLength,
            })
            @!field.error()
          @end
          @!button({
            text: 'Wyślij kod na nowy adres',
            type: 'submit',
            class: 'btn--primary',
            'x-bind:disabled': 'submitting',
          })
        @end
      </details>
    </section>

    <section class="account-section">
      <div>
        <span class="eyebrow">Powiadomienia</span>
        <h2>Numer do alertów SMS</h2>
        <p>
          @if(user.phoneNumber && user.phoneVerifiedAt)
            Zmieniaj numer tylko wtedy, gdy chcesz przenieść alerty SMS na inny telefon.
          @else
            Potwierdź numer kodem SMS, aby móc wybrać go przy obserwacji połączenia.
          @end
        </p>
      </div>
      @if(user.phoneNumber && user.phoneVerifiedAt)
        <div class="phone-status">
          @svg('lucide:shield-check', { width: 20, height: 20 })
          <div>
            <strong>Numer potwierdzony</strong>
            <span>Numer telefonu kończy się na {{ user.phoneNumber.slice(-3) }}.</span>
          </div>
        </div>
      @end
      @if(pendingPhone)
        <div class="notice notice--info">
          @svg('lucide:message-square-code', { width: 18, height: 18 })
          <div>
            <strong>{{ user.phoneVerifiedAt ? 'Zmiana numeru oczekuje na potwierdzenie' : 'Potwierdź numer telefonu' }}</strong>
            <span>Kod wysłano na numer kończący się na {{ pendingPhone.slice(-3) }}.</span>
            @if(user.phoneNumber && user.phoneVerifiedAt)
              <span>Dotychczasowy numer pozostaje aktywny do potwierdzenia nowego.</span>
            @end
          </div>
        </div>
        @form({
          route: 'account.phone.verify',
          method: 'POST',
          class: 'account-form',
          'x-data': 'submittingForm',
          'x-on:submit': 'handleSubmit($event)',
        })
          @field.root({ name: 'code', id: 'smsVerificationCode' })
            @!field.label({ text: 'Kod z SMS' })
            @!input.control({
              type: 'text',
              inputmode: 'numeric',
              autocomplete: 'one-time-code',
              pattern: '[0-9]{6,8}',
              maxlength: 8,
              required: true,
            })
            @!field.error()
          @end
          <button type="submit" class="btn btn--primary" x-bind:disabled="submitting">
            Potwierdź numer
          </button>
        @end
      @end
      @if(smsEnabled)
        @if(user.phoneNumber && user.phoneVerifiedAt)
          <details class="account-action" id="change-phone">
            <summary class="btn btn--secondary">
              @svg('lucide:refresh-cw', { width: 16, height: 16 })
              Zmień numer telefonu
            </summary>
            <p>Wpisz nowy numer. Dotychczasowy pozostanie aktywny, aż potwierdzisz nowy kodem SMS.</p>
            @include('partials/phone_request_form')
          </details>
        @else
          @include('partials/phone_request_form')
        @end
      @else
        <p>Bramka SMS nie jest jeszcze skonfigurowana. Powiadomienia e-mail pozostają dostępne.</p>
      @end
      @if(user.phoneNumber && user.phoneVerifiedAt)
        <details class="account-action" id="remove-phone">
          <summary class="btn btn--secondary">
            @svg('lucide:trash-2', { width: 16, height: 16 })
            Usuń numer telefonu
          </summary>
          <p>Alerty SMS dla obserwowanych połączeń zostaną przestawione na e-mail.</p>
          @form({
            route: 'account.phone.remove',
            method: 'POST',
            class: 'account-form',
            'x-data': 'submittingForm',
            'x-on:submit': 'handleSubmit($event)',
          })
            @field.root({ name: 'currentPassword', id: 'removePhonePassword' })
              @!field.label({ text: 'Aktualne hasło, aby usunąć numer' })
              @!input.control({
                type: 'password',
                autocomplete: 'current-password',
                maxlength: passwordMaxLength,
                required: true,
              })
              @!field.error()
            @end
            <button type="submit" class="btn btn--secondary" x-bind:disabled="submitting">
              Potwierdź usunięcie numeru
            </button>
          @end
        </details>
      @end
    </section>

    <section class="account-section">
      <div>
        <span class="eyebrow">Bezpieczeństwo</span>
        <h2>Aktywne sesje</h2>
        <p>Możesz wylogować pojedyncze urządzenie albo wszystkie sesje naraz.</p>
      </div>
      @if(!sessionTrackingAvailable)
        <div class="notice notice--error">
          @svg('lucide:triangle-alert', { width: 18, height: 18 })
          <div>
            <strong>Lista sesji jest niedostępna</strong>
            <span>Ustaw SESSION_DRIVER=database albo memory.</span>
          </div>
        </div>
      @elseif(sessions.length === 0)
        <p class="account-muted">Brak zapisanych aktywnych sesji.</p>
      @else
        <div class="session-list">
          @each(item in sessions)
            <article class="session-item">
              <div class="session-item__icon">
                @svg('lucide:monitor-smartphone', { width: 18, height: 18 })
              </div>
              <div class="session-item__body">
                <strong>
                  {{ item.userAgent }}
                  @if(item.current)
                    <span class="status-pill status-pill--ok">Ta sesja</span>
                  @end
                </strong>
                <span>Ostatnia aktywność: {{ item.lastSeenAtLabel }}</span>
                <span>
                  Utworzona:
                  {{ item.createdAtLabel }}
                  · identyfikator
                  {{ item.displayId }}
                </span>
              </div>
              @form({ route: 'account.sessions.revoke', method: 'POST' })
                <input type="hidden" name="sessionId" value="{{ item.id }}" />
                <button type="submit" class="btn btn--secondary btn--sm">
                  {{ item.current ? 'Wyloguj' : 'Unieważnij' }}
                </button>
              @end
            </article>
          @end
        </div>
        @form({
          route: 'account.sessions.revoke_all',
          method: 'POST',
          'x-data': 'submittingForm',
          'x-on:submit': 'handleSubmit($event)',
        })
          <button type="submit" class="btn btn--secondary" x-bind:disabled="submitting">
            @svg('lucide:log-out', { width: 16, height: 16 })
            Wyloguj wszystkie sesje
          </button>
        @end
      @end
    </section>

    <section class="account-section">
      <div>
        <span class="eyebrow">Twoje dane</span>
        <h2>Eksport danych</h2>
        <p>Pobierz profil, obserwowane połączenia i historię cen w pliku JSON.</p>
      </div>
      <a class="btn btn--secondary" href="{{ urlFor('account.export') }}">
        @svg('lucide:download', { width: 16, height: 16 })
        Pobierz moje dane
      </a>
    </section>

    <section class="account-section">
      <div>
        <span class="eyebrow">Strefa niebezpieczna</span>
        <h2>Usuń konto</h2>
        <p>Operacja trwale usuwa konto, obserwacje i historię cen. Nie można jej cofnąć.</p>
      </div>
      <details
        class="account-action"
        id="delete-account"
        {{
          html.attrs({
            open:
              old('accountAction') === 'delete' ||
              flashMessages.get('accountAction') === 'delete',
          })
        }}
      >
        <summary class="btn btn--secondary">
          @svg('lucide:trash-2', { width: 16, height: 16 })
          Usuń konto
        </summary>
        @form({
          route: 'account.destroy',
          method: 'DELETE',
          class: 'account-form',
          'x-data': 'submittingForm',
          'data-confirm': 'Czy na pewno trwale usunąć konto?',
          'x-on:submit': 'handleSubmit($event)',
        })
          <input type="hidden" name="accountAction" value="delete" />
          @field.root({ name: 'password' })
            @!field.label({ text: 'Aktualne hasło' })
            @!input.control({
              type: 'password',
              autocomplete: 'current-password',
              maxlength: passwordMaxLength,
            })
            @!field.error()
          @end
          @field.root({ name: 'confirmation' })
            @!field.label({ text: 'Wpisz USUŃ' })
            @!input.control({ autocomplete: 'off', placeholder: 'USUŃ' })
            @!field.error()
          @end

          <button type="submit" class="btn btn--danger" x-bind:disabled="submitting">
            @svg('lucide:trash-2', { width: 16, height: 16 })
            Usuń konto na zawsze
          </button>
        @end
      </details>
    </section>
  </div>
@end

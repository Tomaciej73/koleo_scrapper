@layouts.auth()
  <h1 class="auth__title">Ustaw nowe hasło</h1>
  <p class="auth__sub">Po zmianie hasła wszystkie wcześniejsze sesje zostaną unieważnione.</p>
  @form({
    route: 'password_reset.update',
    method: 'POST',
    class: 'auth__form',
    'x-data': 'passwordResetForm',
    'x-on:submit': 'handleSubmit($event)',
  })
    <input type="hidden" name="token" x-bind:value="token" />
    <p class="field__error" x-bind:hidden="!tokenError" x-text="tokenError" hidden x-cloak></p>
    @field.root({ name: 'password' })
      @!field.label({ text: 'Nowe hasło' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••••••',
      })
      <span class="field__hint">
        Użyj od
        {{ passwordMinLength }}
        do
        {{ passwordMaxLength }}
        znaków.
      </span>
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Powtórz nowe hasło' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Zmień hasło',
      type: 'submit',
      block: true,
      class: 'auth__submit',
      'x-bind:disabled': 'submitDisabled',
      'x-text': "submitting ? 'Zmieniam…' : 'Zmień hasło'",
    })
  @end
@end

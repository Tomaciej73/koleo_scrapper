@layouts.auth()
  <h1 class="auth__title">Reset hasła</h1>
  <p class="auth__sub">Podaj adres konta. Wyślemy jednorazowy link do ustawienia nowego hasła.</p>
  @form({
    route: 'password_reset.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': 'submittingForm',
    'x-on:submit': 'handleSubmit($event)',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adres e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'you@example.com',
      })
      @!field.error()
    @end
    @!button({
      text: 'Wyślij link resetujący',
      type: 'submit',
      block: true,
      class: 'auth__submit',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Wysyłam…' : 'Wyślij link resetujący'",
    })
  @end

  <p class="auth__foot">
    @link({ route: 'session.create', class: 'il' })
      Wróć do logowania
    @end
  </p>
@end

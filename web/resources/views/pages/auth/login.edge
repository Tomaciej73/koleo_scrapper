@layouts.auth()
  <h1 class="auth__title">Witaj ponownie</h1>
  <p class="auth__sub">Zaloguj się, aby zobaczyć monitorowane połączenia.</p>
  <p class="auth__sub">
    Jeśli przerwano potwierdzanie e-maila, zaloguj się adresem konta i hasłem. Wrócisz do wpisywania kodu.
  </p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': 'submittingForm',
    'x-on:submit': 'handleSubmit($event)',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adres e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'ty@example.com',
        maxlength: emailMaxLength,
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Hasło' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
        maxlength: passwordMaxLength,
      })
      @!field.error()
    @end
    @!button({
      text: 'Zaloguj się',
      type: 'submit',
      block: true,
      class: 'auth__submit',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Logowanie…' : 'Zaloguj się'",
    })
  @end

  <p class="auth__foot auth__foot--compact">
    @link({ route: 'password_reset.create', class: 'il' })
      Nie pamiętasz hasła?
    @end
  </p>

  <p class="auth__foot">
    Nie masz konta?
    @link({ route: 'new_account.create', class: 'il' })
      Załóż konto
    @end
  </p>
@end

@layouts.auth()
  <div class="verification-icon" aria-hidden="true">
    @svg('lucide:mail-check', { width: 28, height: 28 })
  </div>
  <h1 class="auth__title">Potwierdź adres e-mail</h1>
  <p class="auth__sub">
    Wysłaliśmy kod na
    <strong>{{ email }}</strong>. Wpisz go poniżej, aby aktywować konto.
  </p>
  @form({
    route: 'email_verification.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': 'verificationCode',
    'x-on:submit': 'handleSubmit($event)',
    'x-on:paste': 'handlePaste($event)',
    'data-code-length': codeIndexes.length,
  })
    @field.root({ name: 'code' })
      @!field.label({ text: 'Kod aktywacyjny' })
      <div class="verification-code" role="group" aria-label="Kod aktywacyjny">
        @each(index in codeIndexes)
          <input
            type="text"
            inputmode="numeric"
            autocomplete="{{ index === 0 ? 'one-time-code' : 'off' }}"
            maxlength="1"
            pattern="[0-9]"
            class="verification-code__digit"
            data-code-index="{{ index }}"
            x-model="digits[{{ index }}]"
            x-on:input="handleInput({{ index }}, $event)"
            x-on:keydown="handleKeydown({{ index }}, $event)"
            aria-label="Cyfra {{ index + 1 }} z {{ codeIndexes.length }}"
          />
        @end
      </div>
      <input x-ref="code" type="hidden" name="code" />
      @!field.error()
    @end
    @!button({
      text: 'Aktywuj konto',
      type: 'submit',
      block: true,
      class: 'auth__submit',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Sprawdzam…' : 'Aktywuj konto'",
    })
  @end

  <div class="verification-resend">
    <span>Kod nie dotarł albo wygasł?</span>
    @form({
      route: 'email_verification.resend',
      method: 'POST',
      'x-data': 'resendCountdown',
      'data-seconds': resendAfterSeconds,
      'x-on:submit': 'submitting = true',
    })
      <button
        type="submit"
        class="link-button"
        x-bind:disabled="seconds > 0 || submitting"
        x-text="buttonLabel"
      >
        Wyślij nowy kod
      </button>
    @end
  </div>

  <p class="auth__foot">
    @link({ route: 'session.create', class: 'il' })
      Wróć do logowania
    @end
  </p>
@end

@layouts.auth({ title: 'Rejestracja konta' })
  <h1 class="auth__title">Załóż konto</h1>
  <p class="auth__sub">Zapisuj połączenia i przygotuj własne alerty cenowe.</p>
  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': 'submittingForm',
    'x-on:submit': 'handleSubmit($event)',
  })
    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Imię i nazwisko' })
      @!input.control({ autocomplete: 'name', placeholder: 'Ada Lovelace' })
      @!field.error()
    @end
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adres e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'ty@example.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Hasło' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      <span class="field__hint">Od {{ passwordMinLength }} do {{ passwordMaxLength }} znaków.</span>
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Powtórz hasło' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Załóż konto',
      type: 'submit',
      block: true,
      class: 'auth__submit',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Tworzenie konta…' : 'Załóż konto'",
    })
  @end

  <p class="auth__foot">

    Masz już konto?

    @link({ route: 'session.create', class: 'il' })
      Zaloguj się
    @end
  </p>
@end

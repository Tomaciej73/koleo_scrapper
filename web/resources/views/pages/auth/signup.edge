@layouts.auth()
  <h1 class="auth__title">Załóż konto</h1>
  <p class="auth__sub">Zapisuj połączenia i przygotuj własne alerty cenowe.</p>
  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Imię i nazwisko' })
      @!input.control({ autocomplete: 'name', placeholder: 'Ada Lovelace' })
      @!field.error()
    @end
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'you@example.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Hasło' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Powtórz hasło' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Załóż konto',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Tworzenie konta…' : 'Załóż konto'",
    })
  @end

  <p class="auth__foot">
    Masz już konto?
    @link({ route: 'session.create', class: 'il' })
      Zaloguj się
    @end
  </p>
@end

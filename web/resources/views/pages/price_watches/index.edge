@layouts.app({ title: 'Obserwowane połączenia' })
  @page()
    <section class="dashboard-hero">
      <div>
        <span class="eyebrow">Alerty cenowe</span>
        <h1>Obserwowane połączenia</h1>
        <p>Historia cen, harmonogram i status każdego alertu w jednym miejscu.</p>
      </div>
      <div class="page-actions">
        @if(alertsEnabled)
          @form({
            route: 'price_watches.check',
            method: 'POST',
            'x-data': 'submittingForm',
            'x-on:submit': 'handleSubmit($event)',
          })
            <button type="submit" class="btn btn--secondary" x-bind:disabled="submitting">
              @svg('lucide:refresh-cw', { width: 16, height: 16 })
              <span x-text="submitting ? 'Sprawdzam…' : 'Sprawdź teraz'">Sprawdź teraz</span>
            </button>
          @end
        @end
        @link({ route: 'dashboard', class: 'btn btn--primary' })
          @svg('lucide:plus', { width: 16, height: 16 })
          Dodaj połączenie
        @end
      </div>
    </section>

    <div class="status-grid">
      <div class="status-card">
        <span>Źródło cen</span>
        <strong>{{ providerMode === 'demo' ? 'Tryb demo offline' : cdEnabled ? 'KOLEO i ČD' : 'Źródło KOLEO' }}</strong>
      </div>
      <div class="status-card">
        <span>Automatyczne sprawdzanie</span>
        <strong>{{ alertsEnabled ? 'Aktywne' : 'Wyłączone' }}</strong>
      </div>
      <div class="status-card">
        <span>Wysyłka e-mail</span>
        <strong>{{ mailEnabled ? 'Aktywna' : 'Czeka na SMTP' }}</strong>
      </div>
    </div>
    @if(providerMode === 'koleo')
      <p class="availability-disclaimer">
        @svg('lucide:info', { width: 14, height: 14 })
        Worker śledzi publiczne ceny wybranego źródła dla jednego pasażera bez ulgi.
        Każda zmiana ceny — wzrost albo spadek — uruchamia
        alert; ustawiony próg jest dodatkowym warunkiem powiadomienia.
      </p>
    @end
    @if(watchItems.some((item) => item.watch.provider === 'cd'))
      <p class="availability-disclaimer">
        @svg('lucide:badge-info', { width: 14, height: 14 })
        @if(czkRate)
          Kwoty PLN w nawiasach są orientacyjne: kurs średni NBP z {{ czkRate.effectiveDate }}
          (1 CZK = {{ czkRate.mid }} PLN). Historia cen ČD pozostaje w CZK; nowe progi podajesz w PLN.
        @else
          Kurs NBP jest chwilowo niedostępny — ceny ČD pokazujemy w CZK, a ocena progów PLN czeka na kurs.
        @end
      </p>
    @end
    @if(watchItems.length === 0)
      <div class="empty-state empty-state--large">
        @svg('lucide:bell-off', { width: 32, height: 32 })
        <h2>Nie obserwujesz jeszcze żadnego połączenia</h2>
        <p>Wyszukaj trasę i kliknij „Obserwuj cenę” przy wybranym kursie.</p>
        @link({ route: 'dashboard', class: 'btn btn--primary' })
          Przejdź do wyszukiwarki
        @end
      </div>
    @else
      <div class="watch-list">
        @each(item in watchItems)
          @let(watch = item.watch)
          @let(priceChange =
            watch.baselinePriceCents !== null && watch.lastPriceCents !== null
              ? watch.lastPriceCents - watch.baselinePriceCents
              : null)
          <article class="watch-card">
            <div class="watch-card__status">
              <div class="watch-card__status-badges">
                <span class="status-pill status-pill--muted">{{ watch.provider === 'cd' ? 'ČD · CZK' : watch.provider === 'demo' ? 'Demo' : 'KOLEO · PLN' }}</span>
                <span
                  class="status-pill {{ watch.status === 'active' ? 'status-pill--ok' : 'status-pill--muted' }}"
                >
                  {{
                    watch.status === 'active'
                      ? 'Aktywne'
                      : watch.status === 'paused'
                        ? 'Wstrzymane'
                        : watch.status === 'connection_missing'
                          ? 'Nie odnaleziono kursu'
                          : 'Zakończone'
                  }}
                </span>
                <span
                  class="status-pill {{ watch.lastTicketAvailability === 'available' ? 'status-pill--ok' : 'status-pill--muted' }}"
                  title="Informacja dotyczy możliwości zakupu biletu u wybranego dostawcy, a nie gwarancji konkretnego miejsca siedzącego."
                >
                  @svg(
                    watch.lastTicketAvailability === 'available'
                      ? 'lucide:ticket-check'
                      : watch.lastTicketAvailability === 'unavailable'
                        ? 'lucide:ticket-x'
                        : 'lucide:circle-help',
                    { width: 14, height: 14 }
                  )
                  {{
                    watch.lastTicketAvailability === 'available'
                      ? 'Zakup dostępny'
                      : watch.lastTicketAvailability === 'unavailable'
                        ? 'Zakup niedostępny'
                        : 'Dostępność nieznana'
                  }}
                </span>
              </div>
              <span>{{ watch.travelDate.toFormat('dd.LL.yyyy') }}</span>
            </div>

            <div class="watch-card__route">
              <div><strong>{{ watch.departureTime }}</strong><span>{{ watch.origin }}</span></div>
              <div class="watch-card__line"><span></span></div>
              <div class="connection-time--right">
                <strong>{{ watch.arrivalTime || '—' }}</strong>
                @if(watch.arrivalTime && item.arrivalDayOffset > 0)
                  <small class="arrival-next-day">
                    +{{ item.arrivalDayOffset }}
                    {{ item.arrivalDayOffset === 1 ? 'dzień' : 'dni' }}
                    ·
                    {{ item.arrivalDate.toFormat('dd.LL.yyyy') }}
                  </small>
                @end

                <span>{{ watch.destination }}</span>
              </div>
            </div>

            <div class="watch-card__train">
              @svg('lucide:train', { width: 15, height: 15 })
              {{ watch.trainName || 'Połączenie kolejowe' }}
            </div>
            @if(watch.lastAvailabilityMessage)
              <div class="watch-availability" role="status">
                @svg(
                  watch.lastTicketAvailability === 'available'
                    ? 'lucide:ticket-check'
                    : 'lucide:clock-3',
                  { width: 17, height: 17 }
                )
                <div>
                  <strong>
                    {{
                      watch.lastTicketAvailability === 'available'
                        ? 'Bilet można obecnie kupić'
                        : 'Bilet nie jest obecnie dostępny w sprzedaży'
                    }}
                  </strong>
                  <span>{{ watch.lastAvailabilityMessage }}</span>
                </div>
              </div>
            @end
            @if(watch.lastErrorMessage)
              <div class="watch-error" role="status">
                @svg('lucide:triangle-alert', { width: 17, height: 17 })
                <div>
                  <strong>Ostatnie sprawdzenie nie powiodło się</strong>
                  <span>{{ watch.lastErrorMessage }}</span>
                  @if(watch.lastErrorAt)
                    <small>
                      {{
                        watch.lastErrorAt
                          .setZone(appTimezone)
                          .toFormat('dd.LL.yyyy HH:mm')
                      }}
                    </small>
                  @end
                </div>
              </div>
            @end

            <div class="watch-card__prices">
              <div>
                <span>Cena początkowa</span><strong>
                  {{ formatPriceWithConversion(watch.baselinePriceCents, watch.provider, czkRate) }}
                </strong>
              </div>
              <div>
                <span>Ostatnia cena</span><strong>{{ formatPriceWithConversion(watch.lastPriceCents, watch.provider, czkRate) }}</strong>
              </div>
              <div>
                <span>Najniższa</span><strong>{{ formatPriceWithConversion(watch.lowestPriceCents, watch.provider, czkRate) }}</strong>
              </div>
              <div>
                <span>Zasada alertu</span>
                <strong>
                  {{ item.targetPriceLabel }}
                </strong>
              </div>
            </div>
            @if(priceChange !== null && priceChange < 0)
              <div class="price-change price-change--down">
                @svg('lucide:trending-down', { width: 15, height: 15 })

                Spadek o
                {{ formatPriceWithConversion(priceChange * -1, watch.provider, czkRate) }}
              </div>
            @elseif(priceChange !== null && priceChange > 0)
              <div class="price-change price-change--up">
                @svg('lucide:trending-up', { width: 15, height: 15 })

                Wzrost o
                {{ formatPriceWithConversion(priceChange, watch.provider, czkRate) }}
              </div>
            @end

            <details class="price-history">
              <summary>
                <span>
                  @svg('lucide:chart-no-axes-combined', { width: 16, height: 16 })

                  Historia cen (
                  {{ item.chartDots.length }}
                  )

                </span>
                @svg('lucide:chevron-down', { width: 16, height: 16 })
              </summary>
              <div class="price-history__content">
                @if(item.chartDots.length)
                  <div class="price-chart">
                    <svg
                      viewBox="0 0 100 40"
                      preserveAspectRatio="none"
                      role="img"
                      aria-label="Wykres historii cen połączenia"
                    >
                      <line x1="0" y1="34" x2="100" y2="34"></line>
                      @if(item.chartDots.length > 1)
                        <polyline points="{{ item.chartPoints }}"></polyline>
                      @end
                      @each(dot in item.chartDots)
                        <circle cx="{{ dot.x }}" cy="{{ dot.y }}" r="1.8">
                          <title>
                            {{ formatPriceWithConversion(dot.priceCents, watch.provider, czkRate) }}
                            ·
                            {{
                              dot.observedAt
                                .setZone(appTimezone)
                                .toFormat('dd.LL.yyyy HH:mm')
                            }}
                          </title>
                        </circle>
                      @end
                    </svg>
                    <div class="price-chart__legend">
                      <span>min. {{ formatPriceWithConversion(item.minimumPrice, watch.provider, czkRate) }}</span>
                      <span>maks. {{ formatPriceWithConversion(item.maximumPrice, watch.provider, czkRate) }}</span>
                    </div>
                  </div>
                  <ol class="price-history__list">
                    @each(entry in item.priceHistory)
                      <li>
                        <time datetime="{{ entry.observedAt.toISO() }}">
                          {{
                            entry.observedAt
                              .setZone(appTimezone)
                              .toFormat('dd.LL.yyyy HH:mm')
                          }}
                        </time>
                        <strong>{{ formatPriceWithConversion(entry.priceCents, watch.provider, czkRate) }}</strong>
                      </li>
                    @end
                  </ol>
                @else
                  <p>Historia pojawi się po pierwszym poprawnym sprawdzeniu ceny.</p>
                @end
              </div>
            </details>

            <div class="watch-card__schedule">
              <div>
                @svg('lucide:timer-reset', { width: 16, height: 16 })
                <span>

                  Sprawdzanie co
                  <strong>{{ watch.checkIntervalMinutes }} min</strong>
                  @if(watch.status === 'active' && watch.nextCheckAt)
                    · następne około
                    {{
                      watch.nextCheckAt
                        .setZone(appTimezone)
                        .toFormat('dd.LL.yyyy HH:mm')
                    }}
                  @end
                </span>
              </div>
              <div class="watch-card__status-actions">
                @if(['active', 'paused'].includes(watch.status))
                  @form({
                    route: 'price_watches.status',
                    routeParams: { id: watch.id },
                    method: 'POST',
                    'x-data': 'submittingForm',
                    'x-on:submit': 'handleSubmit($event)',
                  })
                    <input
                      type="hidden"
                      name="status"
                      value="{{ watch.status === 'active' ? 'paused' : 'active' }}"
                    />
                    <button
                      type="submit"
                      class="btn btn--secondary btn--compact"
                      x-bind:disabled="submitting"
                    >
                      @svg(watch.status === 'active' ? 'lucide:pause' : 'lucide:play', {
                        width: 14,
                        height: 14,
                      })
                      <span x-bind:hidden="submitting">
                        {{ watch.status === 'active' ? 'Wstrzymaj' : 'Wznów' }}
                      </span>
                      <span x-bind:hidden="!submitting" hidden x-cloak>Zapisuję…</span>
                    </button>
                  @end
                @end

                <details class="watch-settings">
                  <summary class="btn btn--secondary btn--compact">
                    @svg('lucide:settings-2', { width: 14, height: 14 })

                    Ustawienia

                  </summary>
                  <div class="watch-settings__popover">
                    @form({
                      route: 'price_watches.settings',
                      routeParams: { id: watch.id },
                      method: 'POST',
                      class: 'watch-form',
                      'x-data': 'submittingForm',
                      'x-on:submit': 'handleSubmit($event)',
                    })
                      <label>
                        <span>Próg ceny (PLN)</span>
                        <input
                          type="number"
                          name="targetPrice"
                          min="0"
                          step="0.01"
                          value="{{ item.targetPriceValue }}"
                          required
                        />
                        <small>
                          Każda zmiana ceny uruchamia alert. Wpisz 0, aby wyłączyć
                          dodatkowe powiadomienie o osiągnięciu progu.
                          @if(watch.provider === 'cd')
                            Cenę ČD przeliczamy po kursie NBP podczas sprawdzania.
                          @end
                        </small>
                        @if(item.legacyCzkTarget)
                          <small>
                            Dotychczasowy próg {{ item.legacyCzkTarget }} nadal działa w CZK.
                            Zapisz ustawienia, aby zastąpić go progiem w PLN.
                          </small>
                        @end
                      </label>
                      <label>
                        <span>Sprawdzaj co ile minut</span>
                        <input
                          type="number"
                          name="checkIntervalMinutes"
                          min="{{ minimumCheckInterval }}"
                          max="{{ maximumCheckInterval }}"
                          step="1"
                          value="{{ watch.checkIntervalMinutes }}"
                          required
                        />
                      </label>
                      <button
                        type="submit"
                        class="btn btn--primary btn--block"
                        x-bind:disabled="submitting"
                      >
                        <span x-text="submitting ? 'Zapisuję…' : 'Zapisz ustawienia'">
                          Zapisz ustawienia
                        </span>
                      </button>
                    @end
                  </div>
                </details>
              </div>
            </div>

            <div class="watch-card__footer">
              <span>
                @svg('lucide:send', { width: 14, height: 14 })
                {{ watch.notificationChannel }}
                 ·
                {{ item.maskedDestination }}
              </span>
              <span>
                @svg('lucide:clock-3', { width: 14, height: 14 })

                Ostatnie sprawdzenie:

                {{
                  watch.lastCheckedAt
                    ? watch.lastCheckedAt.setZone(appTimezone).toFormat('dd.LL.yyyy HH:mm:ss')
                    : 'jeszcze nie sprawdzano'
                }}
              </span>
              @form({
                route: 'price_watches.destroy',
                routeParams: { id: watch.id },
                method: 'DELETE',
                'x-data': 'submittingForm',
                'x-on:submit': 'handleSubmit($event)',
                'data-confirm': 'Czy na pewno usunąć tę obserwację i całą jej historię cen?',
              })
                <button
                  type="submit"
                  class="icon-button"
                  aria-label="Usuń obserwację"
                  title="Usuń obserwację"
                  x-bind:disabled="submitting"
                >
                  @svg('lucide:trash-2', { width: 16, height: 16 })
                </button>
              @end
            </div>
          </article>
        @end
      </div>
    @end
  @end
@end

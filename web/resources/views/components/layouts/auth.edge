<!DOCTYPE html>
<html
  lang="pl"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Logowanie — Koleo Watch</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <div class="auth">
      <div class="auth__form-col">
        @!logo({ size: 28 })
        <div class="auth__form-wrap">{{{ await $slots.main() }}}</div>
        <div class="auth__spacer"></div>
      </div>

      <aside class="auth__aside">
        <div class="auth__aside-top">
          @!themeToggle()
        </div>

        <p class="auth__quote">
          Twoje obserwowane połączenia i alerty cenowe w jednym prostym panelu.
        </p>

        <div>
          <div class="pitch__t">Najpierw prywatność</div>
          <p class="pitch__p">
            Hasła są przechowywane jako bezpieczne skróty. Dane dostępowe do dostawców powiadomień pozostają poza repozytorium.
          </p>
        </div>
      </aside>
    </div>
    @include('partials/flash_alerts')
  </body>
</html>

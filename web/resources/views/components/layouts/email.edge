@let(title = $props.get('title'))
@let(preheader = $props.get('preheader') ?? title)
<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }} - {{ brandName }}</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f1f5f5; color: #172b2b; font-family: Arial, Helvetica, sans-serif;">
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;">
      {{ preheader }}
    </div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; background-color: #f1f5f5;">
      <tr>
        <td align="center" style="padding: 32px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: separate; max-width: 600px; background-color: #ffffff; border: 1px solid #dce7e5; border-radius: 14px;">
            <tr>
              <td style="padding: 25px 32px; background-color: #0f766e; border-radius: 13px 13px 0 0; color: #ffffff; font-size: 18px; font-weight: 700; letter-spacing: 0.04em;">
                {{ brandName }}
              </td>
            </tr>
            <tr>
              <td style="padding: 32px; font-size: 15px; line-height: 1.65;">
                <h1 style="margin: 0 0 20px; color: #123b38; font-size: 24px; line-height: 1.25;">{{ title }}</h1>
                {{{ await $slots.main() }}}
              </td>
            </tr>
            <tr>
              <td style="padding: 20px 32px; border-top: 1px solid #e5eeec; color: #5a6e6b; font-size: 12px; line-height: 1.5;">
                Automatyczne powiadomienie z {{ brandName }}. Aplikacja nie jest serwisem przewoźnika.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

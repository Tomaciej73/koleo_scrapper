@let(pageTitle = $props.get('title') ?? 'Monitoring cen biletów kolejowych')
<!DOCTYPE html>
<html
  lang="pl"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle }} - Koleo Watch</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="header header--floating">
      <div class="header__inner">
        @!logo({ size: 28 })
        <div class="header__right">
          @!themeToggle()
          @if(auth?.user)
            @link({ route: 'dashboard', class: 'btn btn--primary btn--sm' })
              Wyszukiwarka
            @end
          @else
            @link({ route: 'session.create', class: 'btn btn--ghost btn--sm' })
              Zaloguj
            @end
            @link({ route: 'new_account.create', class: 'btn btn--primary btn--sm' })
              Załóż konto
            @end
          @end
        </div>
      </div>
    </header>
    {{{ await $slots.main() }}}
    @include('partials/flash_alerts')
  </body>
</html>

@let(size = $props.get('size', 26))
@link({
  route: 'home',
  'aria-label': 'Koleo Watch',
  class: 'brand',
})
  <span class="brand__mark" style="width: {{ size }}px; height: {{ size }}px;">
    @svg('lucide:train-front', { width: size - 8, height: size - 8 })
  </span>
  <span class="brand__name">Koleo Watch</span>
@end

@let(labelTextFromSlot = await $slots.main())
@let(classes = ['field__label'])

<label {{
  $props
    .except(['text'])
    .merge({
      for: $context.id,
      class: classes,
      'data-invalid': $context.hasErrors ? 'true' : false,
    })
    .toAttrs()
}}>
  @if(labelTextFromSlot.trim())
    {{{ labelTextFromSlot }}}
  @else
    {{ $props.get('text') ?? '' }}
  @end
</label>

# Node
TZ=UTC
APP_TIMEZONE=Europe/Warsaw
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_COLORIZE=true
LOG_LEVEL_COLORS="info:blue,warn:yellow,error:red,fatal:red"
LOG_MESSAGE_COLORS="default:white,warn:yellow,error:red,fatal:red"
LOG_TIME_FORMAT="SYS:dd/mm/yyyy HH:MM:ss"
LOG_SINGLE_LINE=false
LOG_SHOW_CONTEXT=false
# Optional: full account email and searched station names in logs (personal data).
AUDIT_LOG_PERSONAL_DATA=false
APP_KEY=
APP_URL=http://${HOST}:${PORT}
TRUSTED_PROXIES=loopback
DB_DATABASE=tmp/db.sqlite3
DB_CONNECTION=sqlite
DB_DEBUG=false
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
SQLITE_BUSY_TIMEOUT_MS=5000
DB_BACKUP_DIR=tmp/backups
DB_BACKUP_RETENTION_COUNT=14

# Session
SESSION_DRIVER=database

# Abuse protection (database for production; memory only for tests/development)
LIMITER_STORE=database
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_LOGIN_FAILURES=5
RATE_LIMIT_OTP_REQUESTS=5
RATE_LIMIT_SEARCH_REQUESTS=30
RATE_LIMIT_CHECK_NOW_REQUESTS=3
RATE_LIMIT_PASSWORD_RESET_REQUESTS=5
RATE_LIMIT_CSP_REPORT_REQUESTS=60
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_CHECK_NOW_WINDOW_SECONDS=300
RATE_LIMIT_BLOCK_SECONDS=900

# Start with report-only. Change CSP_REPORT_ONLY=false after reviewing CSP reports.
CSP_ENABLED=true
CSP_REPORT_ONLY=true
CSP_DEFAULT_SRC="'self'"
CSP_SCRIPT_SRC="'self'"
CSP_STYLE_SRC="'self'"
CSP_IMG_SRC="'self' data:"
CSP_FONT_SRC="'self' data:"
CSP_CONNECT_SRC="'self'"
CSP_OBJECT_SRC="'none'"
CSP_BASE_URI="'self'"
CSP_FORM_ACTION="'self'"
CSP_FRAME_ANCESTORS="'none'"
CSP_REPORT_URI=/security/csp-report
CSP_UPGRADE_INSECURE_REQUESTS=false

# Search provider: demo works offline; koleo requires authorized API access
PRICE_PROVIDER=demo
CD_ENABLED=false
CD_WEB_BASE_URL=https://www.cd.cz/en/spojeni-a-jizdenka/
CD_STATION_AUTOCOMPLETE_URL=https://ip4azak-prod.cdis.cz/DataWS/ACEStations
CD_STATION_COMBINATION=CDvyhledavacWeb
CD_STATION_LANGUAGE=en
CD_REQUEST_TIMEOUT_MS=10000
CD_REQUEST_MAX_RETRIES=2
CD_REQUEST_RETRY_BASE_DELAY_MS=250
CD_REQUEST_MAX_CONCURRENCY=2
CD_WEB_MAX_REDIRECTS=3
CD_SEARCH_MAX_PAGES=6
NBP_CZK_RATE_URL=https://api.nbp.pl/api/exchangerates/rates/a/czk/?format=json
NBP_REQUEST_TIMEOUT_MS=5000
NBP_RATE_CACHE_SECONDS=21600
NBP_RATE_FAILURE_RETRY_SECONDS=300
NBP_RATE_MAX_STALE_SECONDS=604800
KOLEO_API_BASE_URL=https://api.koleo.pl/v2
KOLEO_CLIENT_USER_AGENT=Koleo-Watch/1.0
KOLEO_CLIENT_NAME=
KOLEO_CLIENT_VERSION=
KOLEO_EOL_RESPONSE_VERSION=
KOLEO_REQUEST_TIMEOUT_MS=10000
KOLEO_REQUEST_MAX_RETRIES=2
KOLEO_REQUEST_RETRY_BASE_DELAY_MS=250
KOLEO_REQUEST_RETRY_MAX_DELAY_MS=2000
KOLEO_REQUEST_MAX_CONCURRENCY=4
SEARCH_RESULT_LIMIT=20
STATION_SEARCH_MIN_LENGTH=2
STATION_SEARCH_RESULT_LIMIT=8
STATION_SEARCH_CACHE_SECONDS=300
DEMO_PRICE_OFFSET_CENTS=0

# Alerts are disabled until authorized access and delivery are configured
ALERTS_ENABLED=false
ALERT_CHECK_INTERVAL_MINUTES=15
ALERT_MIN_CHECK_INTERVAL_MINUTES=5
ALERT_MAX_CHECK_INTERVAL_MINUTES=1440
ALERT_WORKER_TICK_SECONDS=60
ALERT_WORKER_BATCH_SIZE=100
PRICE_WATCH_MAX_PER_USER=25
ALERT_DAILY_MAX_MESSAGES_PER_USER=20
ALERT_WATCH_LOCK_TIMEOUT_SECONDS=300
ALERT_CONNECTION_MISSING_THRESHOLD=3
ALERT_OUTBOX_BATCH_SIZE=25
ALERT_OUTBOX_MAX_ATTEMPTS=5
ALERT_OUTBOX_RETRY_BASE_SECONDS=60
ALERT_OUTBOX_RETRY_MAX_SECONDS=3600
ALERT_OUTBOX_LOCK_TIMEOUT_SECONDS=300
ALERT_OUTBOX_RETENTION_DAYS=90
PASSWORD_RESET_DELIVERY_RETENTION_DAYS=30
PRICE_HISTORY_DISPLAY_LIMIT=30
PRICE_HISTORY_RETENTION_DAYS=365
MAIL_ENABLED=false
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_MAX_LENGTH=254
FULL_NAME_MAX_LENGTH=120
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_MIN_RESPONSE_MS=250
PASSWORD_RESET_RESPONSE_JITTER_MS=100
TICKET_SALES_MAX_ADVANCE_DAYS=90
KOLEO_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
KOLEO_CIRCUIT_BREAKER_OPEN_SECONDS=300

# HTTP and observability
BODY_PARSER_FORM_LIMIT=128kb
BODY_PARSER_JSON_LIMIT=128kb
BODY_PARSER_MULTIPART_LIMIT=256kb
HEALTH_WORKER_STALE_SECONDS=180
HEALTH_QUEUE_STALE_SECONDS=600
# Metrics return 404 until a strong token is configured
METRICS_TOKEN=

# SMTP
MAIL_MAILER=smtp
MAIL_FROM_NAME=Koleo Watch
MAIL_FROM_ADDRESS=alerts@example.com
# Port 465: SMTP_SECURE=true and SMTP_REQUIRE_TLS=false
# Port 587: SMTP_SECURE=false and SMTP_REQUIRE_TLS=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
# Optional CA certificate bundle, relative to the web directory or absolute
SMTP_CA_FILE=
# Optional certificate hostname when SMTP_HOST is a DNS alias
SMTP_TLS_SERVERNAME=
SMTP_USERNAME=
SMTP_PASSWORD=

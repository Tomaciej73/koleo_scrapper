# Node
TZ=UTC
APP_TIMEZONE=Europe/Warsaw
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
DB_DATABASE=tmp/db.sqlite3
DB_DEBUG=false

# Session
SESSION_DRIVER=cookie

# Search provider: demo works offline; koleo requires authorized API access
PRICE_PROVIDER=demo
SEARCH_RESULT_LIMIT=20
STATION_SEARCH_MIN_LENGTH=2
STATION_SEARCH_RESULT_LIMIT=8
STATION_SEARCH_CACHE_SECONDS=300
DEMO_PRICE_OFFSET_CENTS=0

# Alerts are disabled until authorized access and delivery are configured
ALERTS_ENABLED=false
ALERT_CHECK_INTERVAL_MINUTES=15
ALERT_MIN_CHECK_INTERVAL_MINUTES=5
ALERT_MAX_CHECK_INTERVAL_MINUTES=1440
ALERT_WORKER_TICK_SECONDS=60
MAIL_ENABLED=false
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# SMTP
MAIL_MAILER=smtp
MAIL_FROM_NAME=Koleo Watch
MAIL_FROM_ADDRESS=alerts@example.com
# Port 465: SMTP_SECURE=true and SMTP_REQUIRE_TLS=false
# Port 587: SMTP_SECURE=false and SMTP_REQUIRE_TLS=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USERNAME=
SMTP_PASSWORD=
